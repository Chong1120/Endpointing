# SafeCall environment reference. Copy the relevant section into:
#   backend/.env   (API + worker — server-side secrets)
#   frontend/.env  (browser — PUBLIC values only)
# Never commit real secrets.

# ---------------------------------------------------------------------------
# backend/.env  (Railway: set on BOTH the API and the worker service)
# ---------------------------------------------------------------------------
NODE_ENV=production

# AssemblyAI — https://www.assemblyai.com/dashboard/api-keys (server-side only)
ASSEMBLYAI_API_KEY=
# Random string (>= 16 chars) echoed back by AssemblyAI in the
# X-SafeCall-Webhook-Secret header. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASSEMBLYAI_WEBHOOK_SECRET=
# Delete the transcript at AssemblyAI once the safe archive is complete.
ASSEMBLYAI_DELETE_AFTER_ARCHIVE=true
# Redacted audio format returned by AssemblyAI: mp3 (default) or wav (lossless)
REDACTED_AUDIO_FORMAT=mp3

# Supabase (Project Settings → API). The service-role key is SERVER-SIDE ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_AUDIO_BUCKET=safe-call-audio
# Only needed to run migrations (npm run db:migrate)
DATABASE_URL=

# Redis for BullMQ (Railway Redis: use the private REDIS_URL)
REDIS_URL=redis://localhost:6379

# Public HTTPS base URL of the API — used to build the AssemblyAI webhook URL.
# Leave empty for local dev without a tunnel (worker falls back to status checks).
PUBLIC_API_URL=

# LLM Gateway model for structured call analysis. Must be a model your AssemblyAI
# account can access (a 400 "Your account does not have access to this LLM Gateway
# model" means it can't — qwen3.5-4b-32k-fast works on new accounts).
LLM_MODEL=claude-sonnet-4-6
# Optional second model the gateway tries if the first fails (leave empty for none)
LLM_FALLBACK_MODEL=
# auto = use response_format (strict JSON Schema) when the model supports it,
# otherwise put the schema in the prompt. Or force: json_schema | prompt
LLM_RESPONSE_FORMAT=auto

# Comma-separated browser origins allowed to call the API (wildcards allowed: https://*.vercel.app)
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=200
SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# frontend/.env  (Vercel: Project → Settings → Environment Variables)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
