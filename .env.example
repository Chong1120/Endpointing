# SafeCall environment reference. Copy the relevant section into:
#   backend/.env   (the API — server-side secrets; the same values go into Railway)
#   frontend/.env  (the website — PUBLIC values only; the same values go into Vercel)
# Never commit real secrets.

# ---------------------------------------------------------------------------
# backend/.env  →  Railway (the API service)
# ---------------------------------------------------------------------------
NODE_ENV=production

# AssemblyAI — https://www.assemblyai.com/dashboard/api-keys (server-side only)
ASSEMBLYAI_API_KEY=
# Random string (>= 16 chars) that AssemblyAI echoes back in the
# X-SafeCall-Webhook-Secret header. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASSEMBLYAI_WEBHOOK_SECRET=
# Delete the transcript at AssemblyAI once the safe archive is complete.
ASSEMBLYAI_DELETE_AFTER_ARCHIVE=true
# Redacted audio format returned by AssemblyAI: mp3 (default) or wav (lossless)
REDACTED_AUDIO_FORMAT=mp3

# Supabase — Project URL from the Connect button; key from Settings → API Keys.
# Use the SECRET key (sb_secret_…) or the legacy service_role key. Server only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=safe-call-audio
# Only on your laptop, only to run migrations: Connect → Session pooler string
DATABASE_URL=

# Public HTTPS address of the API (your Railway domain). AssemblyAI sends its
# webhook here. Empty = the API checks transcript status on a timer instead.
PUBLIC_API_URL=

# LLM Gateway models for the call analysis. LLM_MODEL is tried first; while
# your AssemblyAI account can't use it, LLM_FALLBACK_MODEL serves the calls and
# LLM_MODEL is tried again every hour (empty fallback = none).
LLM_MODEL=claude-opus-5
LLM_FALLBACK_MODEL=qwen3.5-4b-32k-fast
# auto = strict JSON Schema when the model supports it, otherwise schema in the prompt
LLM_RESPONSE_FORMAT=auto

# Browser origins allowed to call the API (your Vercel address; wildcards like https://*.vercel.app work)
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=200
SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# frontend/.env  →  Vercel (Project → Settings → Environment Variables)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase PUBLISHABLE key (sb_publishable_…) — designed to be public
VITE_SUPABASE_ANON_KEY=
