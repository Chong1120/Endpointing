NODE_ENV=development
PORT=4000
LOG_LEVEL=info

ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WEBHOOK_SECRET=
ASSEMBLYAI_DELETE_AFTER_ARCHIVE=true
REDACTED_AUDIO_FORMAT=mp3

# Must be a model your AssemblyAI account can access (qwen3.5-4b-32k-fast works on new accounts)
LLM_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=
LLM_RESPONSE_FORMAT=auto

# Local Supabase CLI defaults (printed by `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_AUDIO_BUCKET=safe-call-audio
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

REDIS_URL=redis://localhost:6379

# Public HTTPS URL for AssemblyAI webhooks (tunnel in dev). Empty = status-check fallback.
PUBLIC_API_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=200
SIGNED_URL_TTL_SECONDS=300
