NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# AssemblyAI (server-side only)
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WEBHOOK_SECRET=
ASSEMBLYAI_DELETE_AFTER_ARCHIVE=true
REDACTED_AUDIO_FORMAT=mp3

# Tried first; while your AssemblyAI account can't use it, the fallback serves calls (re-checked hourly)
LLM_MODEL=claude-opus-5
LLM_FALLBACK_MODEL=qwen3.5-4b-32k-fast
LLM_RESPONSE_FORMAT=auto

# Your Supabase project: Project URL from the Connect button,
# SECRET key (sb_secret_…) from Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=safe-call-audio
# Only for `npm run db:migrate`: Connect → Session pooler string with your database password
DATABASE_URL=

# Public HTTPS URL for AssemblyAI webhooks (a tunnel in dev). Empty = status checks on a timer.
PUBLIC_API_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=200
SIGNED_URL_TTL_SECONDS=300
